{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./.tests-dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "lib/orders.ts",
    "lib/mock-data.ts",
    "lib/pricing.ts",
    "lib/api/orders/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
