# Supabase — required for auth, public data, server/client Supabase helpers
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
# Server-only. Do not expose this in browser/client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Encrypts payout bank details at rest (AES-256-GCM). Any strong
# secret/passphrase; it's hashed to a 32-byte key. REQUIRED in production —
# without it, payout account details are stored as plaintext.
PAYOUT_ENCRYPTION_KEY=

# Transactional ticket delivery (TICK-65 / TICK-72). All channel vars are
# OPTIONAL — missing values mean that channel is "skipped", never a crash.
# In-app My Tickets is always the source of truth.

# Email via Resend (the only live external channel today). Server-only.
# RESEND_FROM defaults to onboarding@resend.dev (delivers to the account owner)
# until ticketiv.app is verified in Resend — then set a branded address.
RESEND_API_KEY=
RESEND_FROM="Ticketiv <onboarding@resend.dev>"

# WhatsApp ticket delivery (live adapters — see docs/NOTIFICATIONS.md).
# Set WHATSAPP_PROVIDER + WHATSAPP_API_KEY to enable; unconfigured = graceful skip.
# WHATSAPP_PROVIDER=meta_cloud|twilio|360dialog
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
# meta_cloud: API key = access token; also set the sender phone number id.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# Transactional sends outside the 24h window need an approved template:
# WHATSAPP_TEMPLATE=ticket_delivery
# WHATSAPP_TEMPLATE_LANG=en
# twilio: API key = auth token; also set TWILIO_ACCOUNT_SID + WHATSAPP_FROM (E.164).
# WHATSAPP_FROM=+14155238886
# 360dialog: API key = D360 API key. Optional override:
# WHATSAPP_360_BASE_URL=https://waba-v2.360dialog.io

# SMS fallback delivery (live adapters — see docs/NOTIFICATIONS.md).
# Set SMS_PROVIDER + SMS_API_KEY to enable; unconfigured = graceful skip.
# SMS_PROVIDER=twilio|africastalking|clickatell
SMS_PROVIDER=
SMS_API_KEY=
# twilio: API key = auth token; also set TWILIO_ACCOUNT_SID + SMS_FROM.
# africastalking: API key = AT api key; also set AT_USERNAME (+ optional SMS_FROM sender id).
# clickatell: API key = one-API integration key.
# SMS_FROM=
# TWILIO_ACCOUNT_SID=
# AT_USERNAME=

# Canonical public origin of the app. Used for referral/invite links, auth
# email redirects and as the fallback for ticket links. Must be set to
# https://ticketiv.app in production — hardcoded fallbacks exist only for
# local dev.
NEXT_PUBLIC_APP_URL=https://ticketiv.app

# Public base URL used to build secure ticket links in notifications.
# Falls back to APP_URL when unset.
NEXT_PUBLIC_TICKET_BASE_URL=

# Server-only HMAC secret for capability-scoped ticket view links
# (the /t/{token} route reached from WhatsApp/SMS/email delivery). Any strong
# random string. Without it, delivery falls back to the RLS-gated
# /tickets/{id} link (no guest access). REQUIRED for guest checkout.
TICKET_TOKEN_SECRET=

# Supabase Management API personal access token (server-only).
# Optional — enables the live "Status / Region / Postgres" panel on the
# /super-admin/db screen. Without it the page falls back to a deep link
# to the Supabase dashboard.
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional maps embed key. Features using embedded maps may be disabled when blank.
GOOGLE_MAPS_EMBED_KEY=

# Paystack. Keys may also live in the payment_provider_settings row, which wins
# while its is_enabled flag is set; these are the fallback and what preview and
# UAT actually use.
#
# Keep these on sk_test_/pk_test_ until the money path has passed UAT (TICK-61).
# UAT and production share one Supabase project and one Vercel project
# (docs/adr/0002-shared-supabase-environment.md), so a live key set anywhere is
# a live key everywhere. getPaystackSettings() throws on an sk_live_ key unless
# PAYSTACK_ALLOW_LIVE_MODE is exactly "true" — going live means changing both.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# PAYSTACK_ALLOW_LIVE_MODE=true

# MTN MoMo Collections (sandbox)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_COLLECTIONS_PRIMARY_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_ENVIRONMENT=sandbox

# For Eswatini production (see docs/PAYMENTS.md):
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# MOMO_ENVIRONMENT=swaziland
# MOMO_COLLECTIONS_PRIMARY_KEY=<production key>
# MOMO_API_USER=<provisioned API user UUID>
# MOMO_API_KEY=<provisioned API key>
# Production push callback (configure as MTN X-Callback-Url):
# MOMO_CALLBACK_URL=https://<app>/api/payments/momo/callback

# Vercel API — used by super-admin env var manager
# Generate a token at https://vercel.com/account/tokens (scope: your team)
VERCEL_TOKEN=
# These should already be set from prior MCP/deployment work:
# VERCEL_PROJECT_ID=prj_x5tkBTlSJDByG7ilQjngVyj8J5zW
# VERCEL_TEAM_ID=team_R987pA689C1ByVKxIaFTFQ3o

# Operations alerting (TICK-262). GET /api/cron/ops-alerts expects
# Authorization: Bearer ${CRON_SECRET}. The 5-minute schedule runs in Supabase
# pg_cron (`ticketiv-ops-alerts`), which reads the URL and this secret from
# Vault — keep the Vault copy of ops_alert_cron_secret in step when rotating
# CRON_SECRET here, or alerting stops. Vercel Cron cannot host this cadence on
# the Hobby plan (once per day maximum). See docs/OPERATIONS.md §3.
# OPS_ALERT_WEBHOOK_URL can point to Kaya, Telegram, n8n, or another internal
# ops-channel webhook. Health URLs default to NEXT_PUBLIC_APP_URL /api/health
# and /api/health/supabase when OPS_ALERT_HEALTH_URLS is blank.
CRON_SECRET=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_HEALTH_URLS=
OPS_ALERT_HEALTH_TIMEOUT_MS=5000
OPS_ALERT_PAYMENT_WINDOW_MINUTES=15
OPS_ALERT_PAYMENT_MIN_ATTEMPTS=5
OPS_ALERT_PAYMENT_SUCCESS_RATE_MIN=0.85
OPS_ALERT_WEBHOOK_LAG_MINUTES=5

# TapBand telemetry and alerting (TICK-300). Reader/provisioning devices POST
# privacy-minimised events to /api/tapband/telemetry with either
# Authorization: Bearer ${TAPBAND_TELEMETRY_SECRET} or x-tapband-telemetry-secret.
# Devices/internal tooling can read effective feature config from
# /api/tapband/config with Authorization: Bearer ${TAPBAND_CONFIG_SECRET} or
# x-tapband-config-secret.
# Call GET /api/cron/tapband-alerts from the external monitor with
# Authorization: Bearer ${CRON_SECRET}; alerts reuse OPS_ALERT_WEBHOOK_URL.
TAPBAND_CONFIG_SECRET=
TAPBAND_ENVIRONMENT=production
TAPBAND_TELEMETRY_SECRET=
TAPBAND_TELEMETRY_HASH_SALT=
TAPBAND_ALERT_WINDOW_MINUTES=15
TAPBAND_ALERT_AUTH_FAILURES=3
TAPBAND_ALERT_SERIAL_ENUMERATION=10
TAPBAND_ALERT_DUPLICATE_ADMISSIONS=3
TAPBAND_ALERT_READER_ERRORS=5

# Rate limiting (TICK-177). Optional — when BOTH are unset the limiter is a
# no-op and every request is allowed. Set to enable per-IP/per-user limits on
# auth, payments, scanner, search, waitlist and promo-code routes.
# Create a database at https://console.upstash.com (Redis, REST enabled).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push notifications — VAPID keys (TICK-214). OPTIONAL: when unset, push
# delivery is silently skipped (no crashes). Generate a key pair with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is sent to the browser to subscribe.
# VAPID_PRIVATE_KEY is server-only — never expose it in client code.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Error monitoring — Sentry (TICK-173). All OPTIONAL: when the DSNs are unset,
# Sentry.init is disabled and capture is a no-op (no crashes, no network).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sampling (0..1). Defaults: traces 0.1, replay-on-error 0.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Source-map upload at build time (Vercel only). Skipped when token absent.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
