{
  "name": "ticketiv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mobile": "pnpm --filter @ticketiv/app-consumer test && pnpm --filter @ticketiv/app-access test && pnpm --filter @ticketiv/adapters test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "pnpm --filter @ticketiv/app-consumer typecheck && pnpm --filter @ticketiv/app-access typecheck && pnpm --filter @ticketiv/adapters typecheck",
    "check:demo": "bash scripts/check-demo-patterns.sh",
    "check:mobile": "pnpm test:mobile && pnpm typecheck:mobile",
    "check:permissions": "node scripts/check-rpc-permissions.mjs",
    "check:service-role": "node scripts/check-service-role-boundary.mjs",
    "check:crossorg": "node scripts/check-cross-org-authorization.mjs",
    "check:routes": "node scripts/check-internal-routes.mjs",
    "seed:uat": "node scripts/seed-uat.mjs",
    "seed:uat:teardown": "node scripts/seed-uat.mjs --teardown",
    "payouts:reencrypt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/reencrypt-payout-accounts.mjs",
    "check:release": "pnpm lint && pnpm test && pnpm typecheck && pnpm check:demo && pnpm check:mobile && pnpm check:permissions && pnpm check:service-role && pnpm check:crossorg && pnpm check:routes && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-toast": "1.2.4",
    "@sentry/nextjs": "^10.59.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@ticketiv/shared": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "jsqr": "1.4.0",
    "lucide-react": "^0.454.0",
    "next": "16.0.10",
    "posthog-js": "^1.414.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.60.0",
    "react-qr-code": "2.0.18",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.0.10",
    "jsdom": "^29.1.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}
