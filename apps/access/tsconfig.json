{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "types": ["node", "react", "react-native"]
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["android", "node_modules"]
}
