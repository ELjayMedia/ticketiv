# Turn the `engines` field in package.json from advice into enforcement.
#
# Without this, pnpm prints a warning and installs anyway when the developer is
# on the wrong Node. The failure then surfaces much later — a confusing build or
# runtime error — instead of at the moment it can be acted on. With it, the
# install stops and names the expected version.
#
# Verified safe against a full re-resolution of the tree: no transitive
# dependency declares an engines range this repo violates.
engine-strict=true
